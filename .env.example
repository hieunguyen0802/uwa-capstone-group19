POSTGRES_DB=workload_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password

# Host port used by PostgreSQL container.
DB_PORT=5433

# Optional pgAdmin container account.
PGADMIN_DEFAULT_EMAIL=admin@workload.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# Email delivery (SMTP for real OTP delivery; console backend for dev without SMTP).
# For Gmail, generate an App Password at https://myaccount.google.com/apppasswords
# and put it in EMAIL_HOST_PASSWORD (not your real Gmail password).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your.sender@gmail.com
EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=your.sender@gmail.com
